root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,ts,tsx,json,yml,yaml,css,html,md}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 88

[Makefile]
indent_style = tab

[*.{md,mdx}]
trim_trailing_whitespace = false
